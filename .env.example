# msgb_science 환경변수 템플릿
#
# 이 파일을 .env로 복사한 뒤 값을 채운다. .env는 커밋하지 않는다(.gitignore 처리됨).
# 실제 키 값은 이 파일에 절대 적지 않는다.
#
# 주의: 현재 이 저장소에는 .env를 자동으로 읽는 코드가 없다.
#   - dotenv 의존성 없음, tsx --env-file 플래그도 쓰지 않음
#   - 로컬에서는 셸에서 직접 export하거나, dev 스크립트에 --env-file=.env를 붙여야 적용된다
#   - Vercel 배포에서는 프로젝트 환경변수 설정값이 주입된다
# 아래 4개는 같은 값을 Vercel 환경변수에도 등록해야 한다.


# ── 필수 ────────────────────────────────────────────────

# Supabase PostgreSQL 연결 문자열
# Supabase 대시보드 → Project Settings → Database → Connection string
# 서버리스에서는 pooler(포트 6543) 주소를 쓴다
# 사용처: server/db.ts, drizzle.config.ts (없으면 즉시 throw)
DATABASE_URL=

# Supabase 프로젝트 URL — https://<project-ref>.supabase.co
# 대시보드 → Project Settings → API → Project URL
# 사용처: server/imageUpload.ts, server/routes.ts (이미지 업로드/목록)
SUPABASE_URL=

# Supabase service_role 키 (서버 전용, DB 전체 권한)
# 대시보드 → Project Settings → API → service_role
# 절대 클라이언트 코드나 VITE_ 접두사로 노출하지 않는다
# 사용처: server/imageUpload.ts, server/routes.ts
SUPABASE_SERVICE_KEY=

# 관리자 비밀번호 — x-admin-password 헤더와 비교하는 값
# 비어 있으면 이미지 업로드·글 작성·수정·삭제가 전부 401로 막힌다
# 사용처: server/routes.ts (업로드, 이미지 목록, 글 생성/수정)
ADMIN_PASSWORD=


# ── 브라우저에 노출되는 값 (교사 로그인용) ──────────────
# Vite 는 VITE_ 접두사가 붙은 변수만 클라이언트 번들에 넣는다.
# 아래 두 개는 브라우저에서 Supabase Auth 로그인에 쓰인다.
# anon(publishable) 키는 브라우저 노출을 전제로 설계된 키다.
# service_role 키를 절대 VITE_ 로 넣지 말 것. 넣으면 DB 전체 권한이 공개된다.
# 사용처: client/src/lib/supabase.ts
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=


# ── 선택 / 플랫폼이 설정함 ──────────────────────────────
# 아래는 보통 .env에 적지 않는다. 빈 값을 넣으면 오히려 동작이 깨질 수 있어
# 주석 처리해 둔다. 필요할 때만 주석을 풀 것.

# 실행 환경. package.json의 dev/start 스크립트가 이미 지정한다
# production일 때만 정적 파일을 서빙하고, 그 외에는 Vite 개발 서버를 띄운다
# 사용처: server/index.ts, vite.config.ts, script/build.ts
# NODE_ENV=

# 서버 포트. 미지정 시 5000
# 사용처: server/index.ts
# PORT=

# Replit 환경에서만 자동 주입된다. 존재할 때 Replit 전용 Vite 플러그인이 로드된다
# 로컬 개발에서는 설정하지 않는다
# 사용처: vite.config.ts
# REPL_ID=
